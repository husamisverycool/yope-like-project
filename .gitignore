# Third-party reference material stays local while the GitHub repo is public (directive: internal
# reference only, never redistribute). The INDEX.md files with source URLs are committed, and
# tools/fetch_appstore.py re-downloads store screenshots. Verification side-by-sides contain
# reference crops, so they are local too.
references/**/*.png
references/**/*.jpg
references/**/*.jpeg
references/**/*.webp
references/**/*.gif
references/**/*.mp4
references/**/*.html
design/verification/**/*.png
design/verification/**/*.jpg
references/**/*.css
references/**/*.js
references/**/*.pdf
references/**/*.json
!references/**/INDEX.json
references/**/*.zip
references/**/*.mov
references/**/*.m4a
references/**/*.svg
references/**/*.txt

# Python bytecode from the verification scripts
__pycache__/
*.pyc

# The Jolt demo build copies the sample photos here (CI "ios demo build"); never committed.
ios/App/Resources/DemoPhotos/

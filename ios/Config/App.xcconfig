#include "Base.xcconfig"
#include "InfoPlist.generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
INFOPLIST_FILE = App/Info.plist
CODE_SIGN_ENTITLEMENTS = App/App.entitlements

INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
// The daily invitation countdown (surface daily.liveactivity).
INFOPLIST_KEY_NSSupportsLiveActivities = YES
// iPhone orientations are left to the platform default until the screens pass specifies them. No iPad key: the app is
// iPhone only (OWNER_DECISIONS #25, TARGETED_DEVICE_FAMILY = 1), and an iPad runs it with the iPhone's keys.
// No UIUserInterfaceStyle key: the app follows the system Light / Dark setting (layout.global.appearance,
// MERGE_DECISIONS R-1); media surfaces stay black through color.global.backgroundDeep, not a forced appearance.

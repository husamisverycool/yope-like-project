#include "Base.xcconfig"
#include "InfoPlist.generated.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID).Clip
INFOPLIST_FILE = AppClip/Info.plist
CODE_SIGN_ENTITLEMENTS = AppClip/AppClip.entitlements

INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
// iPhone only, like the app (OWNER_DECISIONS #25): no iPad orientation key.

// The App Clip's icon set (ios/AppClip/Resources; the app icon of owner decision 32, tools/appicon.py).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

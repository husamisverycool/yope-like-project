#include "Base.xcconfig"
#include "InfoPlist.generated.xcconfig"

// share.in: the Share Extension ("Share to Jolt", design/surfaces/share.in.md).
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID).share
INFOPLIST_FILE = ShareExtension/Info.plist
CODE_SIGN_ENTITLEMENTS = ShareExtension/ShareExtension.entitlements
// Extension-only APIs (Xcode requires it of an app extension); the containing app is opened through the responder
// chain by selector (ShareViewController.openContainingApp).
APPLICATION_EXTENSION_API_ONLY = YES
SKIP_INSTALL = YES
// NSItemProvider's callbacks carry SDK-dependent Sendable annotations; Swift 5 mode with complete checking reports
// concurrency issues as warnings (as NotificationService).
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete

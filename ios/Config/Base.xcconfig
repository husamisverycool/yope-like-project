// Hand-written build settings shared by every target. User-facing Info.plist strings
// (purpose strings) come only from InfoPlist.generated.xcconfig (tools/designgen.mjs from
// design/copy.json); this file holds identifiers, versions and non-copy Info.plist keys.
// Include order in each target file: Base.xcconfig, InfoPlist.generated.xcconfig, then the
// target's own settings.

// ---- Identity (config/app.json; AppModelsTests/AppConfigurationTests keeps these equal) ----
APP_BUNDLE_ID = com.husamisverycool.jolt
// config/app.json `domain` (owner decision 33: the invite page's Fly.io address). Release workflows pass the repository
// variable APP_DOMAIN when it is set (`xcodebuild … APP_DOMAIN=…`, .github/workflows/testflight.yml).
APP_DOMAIN = jolt-husamisverycool.fly.dev
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
// config/app.json `ios.teamId` (BLOCKED until owner step 1.1). Empty: unsigned CI builds.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// ---- Platform ----
IPHONEOS_DEPLOYMENT_TARGET = 17.2
// iPhone only (docs/OWNER_DECISIONS.md #25): iPads run the iPhone app in compatibility mode, as they run Retro, Locket
// and BeReal (iPhone-only in their App Store compatibility sections).
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ---- Swift ----
// Swift 6 language mode (strict concurrency) unless a target file overrides it.
SWIFT_VERSION = 6.0
ENABLE_USER_SCRIPT_SANDBOXING = YES

// ---- Info.plist ----
// Generated from build settings (INFOPLIST_KEY_*) merged with each target's small Info.plist
// for keys that have no build setting (NSExtension, UIBackgroundModes, NSAppClip, AppGroupIdentifier).
GENERATE_INFOPLIST_FILE = YES
// Export compliance (App Store Connect asks on every upload without it): the only encryption is the HTTPS / TLS and
// Keychain of iOS itself (URLSession through supabase-swift and RevenueCat), which is exempt — Apple, "Complying with
// encryption export regulations" (developer.apple.com/documentation/security/complying-with-encryption-export-regulations).
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

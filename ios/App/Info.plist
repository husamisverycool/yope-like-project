<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys without an INFOPLIST_KEY_ build setting. Everything else is generated from
     Config/App.xcconfig (GENERATE_INFOPLIST_FILE = YES); purpose strings come from
     Config/InfoPlist.generated.xcconfig. -->
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<!-- The App Clip's Keychain access group: its sign-in is moved into the app at first launch
	     (SessionStorage.appSession; the associated-appclip-app-identifiers entitlement grants the access). -->
	<key>AppClipKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).Clip</string>
	<!-- share.in: the Share Extension opens `<bundle id>://share` to hand the shared photos over (they wait in the App
	     Group inbox; the link carries nothing). The only registered scheme: widget links (`app://`) stay unregistered
	     (AppModels DeepLinkParser). -->
	<key>AppURLScheme</key>
	<string>$(APP_BUNDLE_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID).share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(APP_BUNDLE_ID)</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Silent widget pushes for muted groups (docs/SPEC_FLAGS.md T6). -->
		<string>remote-notification</string>
	</array>
</dict>
</plist>

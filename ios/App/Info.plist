<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys without an INFOPLIST_KEY_ build setting. Everything else is generated from
     Config/App.xcconfig (GENERATE_INFOPLIST_FILE = YES); purpose strings come from
     Config/InfoPlist.generated.xcconfig. -->
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Silent widget pushes for muted groups (docs/SPEC_FLAGS.md T6). -->
		<string>remote-notification</string>
	</array>
</dict>
</plist>

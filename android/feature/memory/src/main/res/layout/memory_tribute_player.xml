<?xml version="1.0" encoding="utf-8"?>
<!-- birthday.tribute player: Media3 PlayerView with its default controls
     (layout.birthday.tribute.player). A TextureView and a transparent shutter let the poster
     (poster_path, the title card) drawn behind it show until the first frame renders. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shutter_background_color="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_artwork="false" />

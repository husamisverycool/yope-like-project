<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- birthday.tribute "Download": MediaStore.Video insert needs no permission on API 29+;
         API 26-28 need write access (design/surfaces/birthday.tribute.md, Platform notes). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Share sheet files (year.story share images, birthday.tribute MP4): content:// URIs with
             FLAG_GRANT_READ_URI_PERMISSION (layout.year.story.shareSheet). Own subclass, so it never
             collides with another module's FileProvider. -->
        <provider
            android:name="app.feature.memory.share.MemoryFileProvider"
            android:authorities="${applicationId}.memory.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>

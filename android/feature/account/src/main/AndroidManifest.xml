<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- onboarding.permission.notifications: Android 13+ runtime permission (asked in context). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- onboarding.permission.contacts / groups.invite (Android card): optional, asked in context. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- groups.invite QR card "Save": MediaStore insert needs no permission on API 29+; API 26–28 need it (minSdk 26). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- settings.account "Take Photo": the content:// target handed to the system camera (TakePicture). -->
        <provider
            android:name="app.feature.account.settings.AccountFileProvider"
            android:authorities="${applicationId}.account.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/account_files" />
        </provider>
    </application>

    <queries>
        <!-- settings.account "Take Photo": the system camera (ACTION_IMAGE_CAPTURE). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- groups.invite: SMS compose (ACTION_SENDTO smsto:) and the Sharesheet. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Legal links in an in-app browser (Custom Tabs) and the Play Subscription Center. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- settings.root "Contact Us". -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Group photo widget (surface widget.android; Retro's Glance widget providers, APK 2026.10.1150).
  minWidth / minHeight / minResize* / targetCell* / resizeMode / reconfigurable = token
  widget.android.layout.provider (200 dp, resizable down to 100 dp, default 2 x 2, both axes).
  updatePeriodMillis = token widget.android.duration.updatePeriod (3600000 ms, Retro's hourly
  safety net; refresh itself is FCM + WorkManager, widget.arrival).
  Description: copy widget.android.description. Label: copy widget.android.label (on the receiver).
  Preview: generated from the current content on Android 15+ (GroupPhotoWidget.providePreview);
  the static previewImage is BLOCKED (owner asset; Retro's preview art is do-not-copy).
  Lock screen (owner decision 18; token widget.android.layout.lockScreen): widgetCategory adds keyguard, so
  the widget is offered on the lock-screen
  widget hub where the OS has one (Android 16 QPR2+ phones, Pixel Tablet; "sized to approximately 4 cells
  wide by 3 cells tall" — https://android-developers.googleblog.com/2025/03/widgets-on-lock-screen-faq.html;
  WIDGET_CATEGORY_KEYGUARD "Indicates that the widget can be displayed on the keyguard", API 17 —
  https://developer.android.com/reference/android/appwidget/AppWidgetProviderInfo). Older releases ignore the
  flag (home screen only). The responsive layouts cover the hub's slot (4 x 3 cells → the Medium class; snapshot
  widget.android_keyguard_*). A tap opens the app only after unlock (MainActivity has no showWhenLocked); the
  generated preview covers every category (Glance setWidgetPreviews default:
  HOME_SCREEN or KEYGUARD or SEARCHBOX). docs/PLATFORM_CONSTRAINTS.md §4.2.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.widget.WidgetConfigureActivity"
    android:description="@string/widget_android_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="200dp"
    android:minHeight="200dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="100dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable" />

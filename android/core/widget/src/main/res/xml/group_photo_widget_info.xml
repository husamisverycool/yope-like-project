<?xml version="1.0" encoding="utf-8"?>
<!--
  Group photo widget (surface widget.android). Sizes are PLATFORM values, not design values:
  default 2x2 cells (WidgetSizeClass.Small); minWidth/minHeight use Android's cell formula for
  pre-Android 12 launchers ((70 x n) - 30 dp for n cells, the value in the platform's own
  default_size_attributes example), targetCell* is used on Android 12+.
  https://developer.android.com/develop/ui/views/appwidgets/layouts#anatomy_determining_size
  Description: copy widget.android.description. Label: widget.android.label = {app_name}, BLOCKED
  until the owner names the app, so the receiver carries none (the picker shows the app label).
  Preview: generated from the current content on Android 15+ (GroupPhotoWidget.providePreview,
  published by WidgetPreviews.publish); the static previewImage fallback is BLOCKED (owner asset).
  Lock-screen hub eligibility (not_keyguard, API 36) is an owner decision: left at the default.
  updatePeriodMillis = token widget.android.duration.updatePeriod (86400000 ms, Locket APK; a
  safety net that re-renders the stored rendition; refresh itself is FCM + WorkManager).
  minWidth / minHeight / minResize* = token widget.android.size.minSize (110 dp).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.widget.WidgetConfigureActivity"
    android:description="@string/widget_android_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="86400000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />

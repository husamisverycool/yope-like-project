<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No POST_PROMOTED_NOTIFICATIONS: the daily invitation is never a Live Update
         (design/surfaces/daily.ongoing.md, MERGE_DECISIONS C-11). -->

    <application>
        <service
            android:name="app.push.AppMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Firebase initialises lazily (FirebaseBootstrap), only when google-services.json was
             present at build time; the app runs without it. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <!-- No token is created until the app asks for one (PushTokens.fetch after sign-in). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The local Supabase stack (`supabase start`) serves plain HTTP on the developer's machine: the
     emulator reaches it at 10.0.2.2 (the host's loopback), a device through `adb reverse` at 127.0.0.1 / localhost.
     Every other host keeps the platform default for targetSdk 28+ (no cleartext). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
